{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAPLink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/UART_1.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407VE",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],
            "preLaunchTask": "build task"
        },
        {
            "name": "ST-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/UART_1.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407VE",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],
            "preLaunchTask": "build task"
        },
        {
            "name": "J-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/UART_2.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407VE",
            "servertype": "jlink",
            "interface": "swd",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],
            "preLaunchTask": "build task"
        },
        {
            "name": "C/C++: arm-none-eabi-gcc.exe 构建和调试活动文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: arm-none-eabi-gcc.exe 生成活动文件"
        }
    ]
}